// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}


model User {
  id Int @id() @default(autoincrement())
  name String
  empNo String
  password String
  rfId String
  role String
  status String @default("use")
  MapGroupSectionUser MapGroupSectionUser[]
  HeaderIssueTemp HeaderIssueTemp[]
  PalletTemp PalletTemp[]
  Pallet Pallet[]
  HeaderClosedTemp HeaderClosedTemp[]
}



model Group {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
  MapGroupSectionUser MapGroupSectionUser[]
}


model Section {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
  MapGroupSectionUser MapGroupSectionUser[]
}


model MapGroupSectionUser {
  id Int @id() @default(autoincrement())
  groupId Int
  sectionId Int
  userId Int
  status String @default("use")
  Section Section @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Group Group @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model PartMaster {
  id Int @id() @default(autoincrement())
  itemNo String
  itemName String
  itemClass String? 
  lotSize Int?    
  timeStmp DateTime @default(now())
  status String @default("use")
}

model Area {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
  MapAreaRack MapAreaRack[]
}

model Rack {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
  MapAreaRack MapAreaRack[]
}

model MapAreaRack {
  id Int @id() @default(autoincrement())
  rackId Int
  areaId Int  
  status String @default("use")
  Rack Rack @relation(fields: [rackId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Area Area  @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  PalletTemp PalletTemp[]
  Pallet Pallet[]
}

model PalletTemp {
  id Int @id() @default(autoincrement())
  date DateTime
  shift String
  mapAreaRackId Int
  labelType String
  userId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  User User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  MapAreaRack MapAreaRack @relation(fields: [mapAreaRackId], references: [id], onDelete: NoAction, onUpdate: NoAction )
  HeaderIssueTemp HeaderIssueTemp[]
}


model Pallet {
  id Int @id() @default(autoincrement())
  PalletNoId Int
  date DateTime 
  shift String 
  mapAreaRackId Int
  labelType String
  userId Int
  timeStmp DateTime @default(now())
  User User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  MapAreaRack MapAreaRack @relation(fields: [mapAreaRackId], references: [id], onDelete: NoAction, onUpdate: NoAction )
  HeaderIssue HeaderIssue[]

}



model HeaderIssueTemp {
  id Int @id() @default(autoincrement())
  palletTempId Int
  itemNo String
  itemName String
  normalQty Int? 
  groupId Int
  controlLot String?
  totalBox Int
  moveMentThreeMonth String
  userId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  User User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  PalletTemp PalletTemp @relation(fields: [palletTempId], references: [id], onDelete:  NoAction, onUpdate: NoAction)
  BoxIssueTemp BoxIssueTemp[]
  MapHeaderIssueTempFraction MapHeaderIssueTempFraction[]
  HeaderIssueTempFraction HeaderIssueTempFraction[]
}

model HeaderIssue {
  id Int @id() @default(autoincrement())
  palletId Int
  itemNo String
  itemName String
  normalQty Int
  fractionQty Int
  groupId Int
  controlLot String
  moveMentThreeMonth String
  userId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  MapHeaderIssueFraction MapHeaderIssueFraction[]
  Pallet Pallet @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Box Box[]
  HeaderClosedTemp HeaderClosedTemp[]
}

model ControlLot {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
}

model Location {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
}

model BoxIssueTemp {
  id Int @id() @default(autoincrement())
  headerId Int
  itemNo String
  itemName String
  wosNo String
  dwg String
  dieNo String
  lotNo String
  qty Int
  timeStmp DateTime @default(now())
  status String @default("use")
  HeaderIssueTemp HeaderIssueTemp @relation(fields: [headerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  MapHeaderIssueTempFraction MapHeaderIssueTempFraction[]
}


model HeaderIssueTempFraction{
  id Int @id() @default(autoincrement())
  qtyBox Int
  headerId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  MapHeaderIssueTempFraction MapHeaderIssueTempFraction[]
  HeaderIssueTemp HeaderIssueTemp @relation(fields: [headerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HeaderIssueFraction{
  id Int @id() @default(autoincrement())
  qtyBox Int
  headerId Int
  timeStmp DateTime @default(now())
  status String @default("use")
}


model MapHeaderIssueTempFraction {
  id Int @id() @default(autoincrement())
  headerId Int
  headerFractionId Int
  boxId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  HeaderIssueTemp HeaderIssueTemp @relation(fields: [headerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  HeaderIssueTempFraction HeaderIssueTempFraction @relation(fields: [headerFractionId], references: [id])
  BoxIssueTemp BoxIssueTemp @relation(fields: [boxId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model MapHeaderIssueFraction {
  id Int @id() @default(autoincrement())
  headerId Int
  boxId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  HeaderIssue HeaderIssue @relation(fields: [headerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Box Box @relation(fields: [boxId], references: [id], onDelete: NoAction, onUpdate: NoAction )
}



model Box {
  id Int @id() @default(autoincrement())
  headId Int
  headClosedId Int?
  itemNo String
  itemName String
  wosNo String
  dwg String
  dieNo String
  lotNo String
  qty Int
  timeStmp DateTime @default(now())
  status String @default("use") 
  HeaderIssue HeaderIssue @relation(fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction )
  MapHeaderIssueFraction MapHeaderIssueFraction[]
  HeaderClosedTemp HeaderClosedTemp[]

}


model HeaderClosedTemp {
  id Int @id() @default(autoincrement())
  boxId Int
  headId Int
  userId Int 
  timeStmp DateTime @default(now())
  status String @default("use")
  Box Box @relation(fields: [boxId], references: [id], onDelete: NoAction, onUpdate: NoAction )
  HeaderIssue HeaderIssue @relation(fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction )
  User User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction )

}

model HeaderClosed {
  id Int @id() @default(autoincrement())
  closedNo String
  timeStmp DateTime @default(now())
  status String @default("use")
}
















