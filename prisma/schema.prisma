// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}


model User {
  id Int @id() @default(autoincrement())
  name String
  empNo String
  password String
  rfId String
  role String
  status String @default("use")
  MapGroupSectionUser MapGroupSectionUser[]
  HeaderIssueTemp HeaderIssueTemp[]
}



model Group {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
  MapGroupSectionUser MapGroupSectionUser[]
}


model Section {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
  MapGroupSectionUser MapGroupSectionUser[]
}


model MapGroupSectionUser {
  id Int @id() @default(autoincrement())
  groupId Int
  sectionId Int
  userId Int
  status String @default("use")
  Section Section @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Group Group @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model PartMaster {
  id Int @id() @default(autoincrement())
  itemNo String
  itemName String
  timeStmp DateTime @default(now())
  status String @default("use")
}

model HeaderIssueTemp {
  id Int @id() @default(autoincrement())
  dateIssue DateTime
  itemNo String
  itemName String
  qtyBox Int
  shift String
  groupId Int
  controlLotId Int
  locationId Int
  totalBox Int
  moveMentThreeMonth String
  userId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  User User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  BoxIssueTemp BoxIssueTemp[]
  MapHeaderIssueTempFraction MapHeaderIssueTempFraction[]
  HeaderIssueTempFraction HeaderIssueTempFraction[]
}

model HeaderIssue {
  id Int @id() @default(autoincrement())
  dateIssue DateTime
  itemNo String
  itemName String
  qtyBox Int
  shift String
  groupId Int
  controlLotId Int
  idPallet String
  locationId Int
  totalBox Int
  moveMentThreeMonth String
  userId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  MapHeaderIssueFraction MapHeaderIssueFraction[]
  HeaderIssueFraction HeaderIssueFraction[]
}

model ControlLot {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
}

model Location {
  id Int @id() @default(autoincrement())
  name String
  status String @default("use")
}

model BoxIssueTemp {
  id Int @id() @default(autoincrement())
  headerId Int
  itemNo String
  itemName String
  wosNo String
  dwg String
  dieNo String
  lotNo String
  qty Int
  timeStmp DateTime @default(now())
  status String @default("use")
  HeaderIssueTemp HeaderIssueTemp @relation(fields: [headerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  MapHeaderIssueTempFraction MapHeaderIssueTempFraction[]
}


model HeaderIssueTempFraction{
  id Int @id() @default(autoincrement())
  qtyBox Int
  headerId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  MapHeaderIssueTempFraction MapHeaderIssueTempFraction[]
  HeaderIssueTemp HeaderIssueTemp @relation(fields: [headerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HeaderIssueFraction{
  id Int @id() @default(autoincrement())
  qtyBox Int
  headerId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  MapHeaderIssueFraction MapHeaderIssueFraction[]
  HeaderIssue HeaderIssue @relation(fields: [headerId], references: [id], onDelete: NoAction, onUpdate: NoAction )
}


model MapHeaderIssueTempFraction {
  id Int @id() @default(autoincrement())
  headerId Int
  headerFractionId Int
  boxId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  HeaderIssueTemp HeaderIssueTemp @relation(fields: [headerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  HeaderIssueTempFraction HeaderIssueTempFraction @relation(fields: [headerFractionId], references: [id])
  BoxIssueTemp BoxIssueTemp @relation(fields: [boxId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model MapHeaderIssueFraction {
  id Int @id() @default(autoincrement())
  headerId Int
  headerFractionId Int
  boxId Int
  timeStmp DateTime @default(now())
  status String @default("use")
  HeaderIssue HeaderIssue @relation(fields: [headerId], references: [id])
  HeaderIssueFraction HeaderIssueFraction @relation(fields: [headerFractionId], references: [id])
}


model HeaderClosedTemp {
  id Int @id() @default(autoincrement())
  boxId Int
  status String @default("use")
}

model HeaderClosed {
  id Int @id() @default(autoincrement())
  closedNO String
  status String @default("use")
}


model Box {
  id Int @id() @default(autoincrement())
  headerIssueId Int
  headerClosedId Int
  itemNo String
  itemName String
  wosNo String
  dwg String
  dieNo String
  lotNo String
  qty Int
  status String @default("use") 
}













